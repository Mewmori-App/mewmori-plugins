{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mewmori-App/mewmori-plugins/main/schema/mewmori-plugin.schema.json",
  "title": "Mewmori Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "version", "apiVersion", "entrypoint", "permissions", "networkHosts", "settings"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": 1 },
    "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.mjs$" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["activities", "commands", "notices", "network", "secureStorage"] }
    },
    "networkHosts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "kind", "required"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{1,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["text", "secret", "boolean"] },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
