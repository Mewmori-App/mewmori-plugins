{
  "id": "mewmori.telegram",
  "displayName": "Telegram",
  "version": "0.3.0",
  "apiVersion": 1,
  "entrypoint": "dist/index.mjs",
  "permissions": [
    "activities",
    "notices",
    "network",
    "secureStorage"
  ],
  "networkHosts": [
    "api.telegram.org"
  ],
  "settings": [
    {
      "key": "botToken",
      "title": "Bot token",
      "kind": "secret",
      "required": false
    }
  ]
}
